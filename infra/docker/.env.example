# Copier en .env (gitignoré) et adapter. Toutes les variables ont un défaut sûr
# pour un POC local ; en prod, changer AU MOINS les mots de passe.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # ⚠️ à changer hors local
POSTGRES_DB=mip_rum
DB_PORT=5433                        # port hôte -> 5432 conteneur

# --- Profils ----------------------------------------------------------------
# Les services démarrés par un simple `docker compose up` (sinon : `up <service>`
# ou `--profile <service>`). `db` et `migrate` suivent d'office.
# COMPOSE_PROFILES=collector,scheduler,mcp

# --- collector --------------------------------------------------------------
COLLECTOR_PORT=4318                 # endpoint OTLP: http://localhost:4318/v1/traces
REQUIRE_API_KEY=false               # true => 403 pour tout app_id inconnu/sans clé
RATE_LIMIT_PER_MIN=600              # par app_id, fenêtre 60 s
IDENTITY_HASH_SECRET=               # HMAC des identifiants visiteur ; vide => identité non persistée
GEOIP_IP_SOURCE=none                # none|socket|railway|xff:<n> ; la base est dans l'image
LOG_LEVEL=info                      # debug|info|warn|error|silent

# --- scheduler --------------------------------------------------------------
SCHEDULER_PORT=4320                 # /health ; /ready et /metrics sous jeton
METRICS_TOKEN=                      # ≥ 32 caractères ; vide => /ready et /metrics en 404
DEADMAN_URL=                        # https ; vide => aucun signal de dead-man's switch

# --- mcp --------------------------------------------------------------------
MCP_PORT=4322                       # point MCP : http://localhost:4322/mcp
MIP_CONSOLE_URL=http://host.docker.internal:3000   # la console dont il relaie l'API v1
