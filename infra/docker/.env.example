# Copier en .env (gitignoré) et adapter. Toutes les variables ont un défaut sûr
# pour un POC local ; en prod, changer AU MOINS les mots de passe.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # ⚠️ à changer hors local
POSTGRES_DB=mip_rum
DB_PORT=5433                        # port hôte -> 5432 conteneur

# --- Profils ----------------------------------------------------------------
# Les services démarrés par un simple `docker compose up` (sinon : `up <service>`
# ou `--profile <service>`). `db` et `migrate` suivent d'office.
# COMPOSE_PROFILES=collector,scheduler,notifier,api,console-api,mcp

# --- collector --------------------------------------------------------------
COLLECTOR_PORT=4318                 # endpoint OTLP: http://localhost:4318/v1/traces
REQUIRE_API_KEY=false               # true => 403 pour tout app_id inconnu/sans clé
RATE_LIMIT_PER_MIN=600              # par app_id, fenêtre 60 s
IDENTITY_HASH_SECRET=               # HMAC des identifiants visiteur ; vide => identité non persistée
IDENTITY_HASH_FINGERPRINT=          # exigée avec le secret : printf %s "$IDENTITY_HASH_SECRET" | node scripts/ops/empreinte-identite.mjs
GEOIP_IP_SOURCE=none                # none|socket|railway|xff:<n> ; la base est dans l'image
LOG_LEVEL=info                      # debug|info|warn|error|silent

# --- scheduler --------------------------------------------------------------
SCHEDULER_PORT=4320                 # /health ; /ready et /metrics sous jeton
METRICS_TOKEN=                      # ≥ 32 caractères ; vide => /ready et /metrics en 404
DEADMAN_URL=                        # https ; vide => aucun signal de dead-man's switch

# --- mcp --------------------------------------------------------------------
MCP_PORT=4322                       # point MCP : http://localhost:4322/mcp
MIP_CONSOLE_URL=http://host.docker.internal:3000   # la console dont il relaie l'API v1

# --- api --------------------------------------------------------------------
API_PORT=4323                       # API de lecture v1, au jeton (CONSOLE_API_TOKENS)

# --- console-api --------------------------------------------------------------
# Sans valeur par défaut, à dessein : vides, le service refuse de démarrer et dit
# laquelle manque (infra/docker/README.md, « console-api »).
CONSOLE_API_PORT=4324               # /v1/* sous secret client ; /health et /live publics
CONSOLE_API_CLIENT_SECRETS=         # secret client attendu de la console (x-mip-client)
SESSION_SIGNING_KEYS=               # trousseau ES256 : node scripts/ops/generer-cles-session.mjs --nouvelle
# IDENTITY_HASH_SECRET (plus haut) : le MÊME que le collector, pour le RGPD par identité.

# --- notifier -----------------------------------------------------------------
NOTIFIER_PORT=4321                  # /health ; hook entrant des tickets
RESEND_API_KEY=                     # vide => les e-mails d'alerte sont « skipped », avec la raison
ALERT_EMAIL_FROM=onboarding@resend.dev
ALERT_EMAIL_TEST_RECIPIENTS=        # destinataires autorisés en mode test Resend, séparés par des virgules
WEBHOOK_SIGNING_SECRET=             # signature HMAC des webhooks sortants (x-mip-signature)
