# OBSOLÈTE — NE PLUS MODIFIER NI RÉFÉRENCER ; À SUPPRIMER APRÈS L'APPLY DE L'IAC.
# Remplacé par `services/scheduler/Dockerfile` (et `services/collector/Dockerfile`) (P1, contrat de service § 9).
# Plus rien DANS LE DÉPÔT ne construit ce fichier : ni `.railway/railway.ts`,
# ni le compose, ni la fumée. Il reste pour UNE raison : le tableau de bord
# Railway le désigne encore comme Dockerfile du service `scheduler`, jusqu'à ce
# que le workflow « Railway IaC » applique le nouveau `dockerfilePath`. Railway
# construisant sur chaque push (`checkSuites: false`), le supprimer dans la même
# fusion ferait échouer la construction de `scheduler` entre la fusion et l'apply
# relu. Une fois l'apply fait et un déploiement de `scheduler` vert sur la
# nouvelle image : supprimer ce fichier, et ses chemins surveillés dans l'IaC.
#
# Image du backend MIP RUM — collecte, travaux planifiés, migrations.
#
# UNE image pour TOUS les services backend : ils partagent le même noyau
# (`@mip/backend`, plus le schéma `@mip/db`) et les mêmes dépendances. Ce qui
# les distingue est la commande de démarrage, choisie par le service :
#
#   node services/collector/server.mjs   collecteur OTLP (traces, logs, replay)
#   node services/scheduler/worker.mjs   déclencheur des travaux planifiés
#   node services/scheduler/migrate.mjs  applique les migrations SQL en attente
#                                        (pré-déploiement du scheduler ; câble
#                                        `main()` de @mip/db/migrate.mjs)
#
# Construire deux images pour deux commandes ferait deux fois le même travail et
# ouvrirait la porte à ce qu'elles divergent d'une version. (P1, PR-C : chaque
# service aura son Dockerfile sous services/<x>/ ; celui-ci reste d'ici là.)
#
# PAS DE pnpm ICI, À DESSEIN. Le dépôt est un monorepo pnpm, mais faire un
# `pnpm install` à la racine tirerait Next.js, React, Recharts et Playwright —
# des centaines de mégaoctets dont le backend n'a aucun usage. La seule
# dépendance runtime est `pg`. On l'installe depuis le manifeste du noyau, ce
# qui en fige la version (8.21.0), et on recompose l'arborescence à la main.
# Le manifeste du noyau déclare aussi `@mip/service-kit: workspace:*`, un
# protocole que npm ne connaît pas : ces entrées-là sont retirées avant
# `npm install` — le paquet correspondant est COPIÉ plus bas, comme les autres.
#
# Contexte de build = RACINE du dépôt (Railway le fait par défaut).
#
# NODE 24 SUR DEBIAN, COMME LE RESTE (P1). L'image tournait sous Node 22 alors
# que la CI testait sous Node 26 et la console sous Node 24 : ce qui tournait en
# production n'était testé nulle part. La version suit `.nvmrc` à la racine.
# Debian (glibc) et non Alpine (musl) : les binaires musl de Node sont au niveau
# « expérimental » de sa matrice de support, et la CI (Ubuntu) comme Vercel
# tournent sur glibc — un module natif ou une résolution DNS qui diffère entre
# musl et glibc se verrait en production sans s'être vu en test.
# ÉPINGLÉE PAR ÉTIQUETTE SEULEMENT : le digest (`@sha256:…`) arrive avec les
# Dockerfiles par service (P1, PR-C, contrat de service § 9).
FROM node:24-bookworm-slim

WORKDIR /app

# 1) La seule dépendance runtime. Installée d'abord : cette couche ne change
#    qu'à un changement de version de pg, donc elle reste en cache.
COPY packages/backend/package.json ./package.json
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));for(const k of Object.keys(p.dependencies||{}))if(String(p.dependencies[k]).startsWith('workspace:'))delete p.dependencies[k];fs.writeFileSync('package.json',JSON.stringify(p))" \
 && npm install --omit=dev --no-audit --no-fund && npm cache clean --force

# 2) Les paquets, placés là où Node résout leurs noms (`@mip/backend/...`,
#    `@mip/db/...`) — exactement comme en développement, où pnpm pose les mêmes
#    liens symboliques. C'est ce qui permet aux services d'écrire
#    `import … from "@mip/backend/lib/receiver.mjs"` sans chemin relatif.
#    `pg` reste résolu en remontant à /app/node_modules.
#
#    @mip/backend : pipeline d'ingestion, travaux, modules partagés (parser OTLP,
#    CORS, limites, scrub, retry, journal), livraison des alertes.
COPY packages/backend/package.json ./node_modules/@mip/backend/package.json
COPY packages/backend/lib          ./node_modules/@mip/backend/lib
COPY packages/backend/jobs         ./node_modules/@mip/backend/jobs
COPY packages/backend/shared       ./node_modules/@mip/backend/shared
# Le dossier de données du GeoIP optionnel (P8.7) : licence, attribution et
# manifeste. La base elle-même n'est PAS dans le dépôt — 4,5 Mio renouvelés tous
# les mois —, elle est déposée juste en dessous. `lib/geoip-db.mjs` la cherche
# en `../data`, d'où ce chemin.
COPY packages/backend/data         ./node_modules/@mip/backend/data
#    @mip/service-kit : le journal (et la décision TLS) que le noyau réexporte.
#    Zéro dépendance : ses seuls fichiers suffisent.
COPY packages/service-kit/package.json ./node_modules/@mip/service-kit/package.json
COPY packages/service-kit/*.mjs        ./node_modules/@mip/service-kit/
#    @mip/db : le migrateur et le SQL qu'il lit À CÔTÉ DE LUI (`sql/`).
COPY packages/db/package.json      ./node_modules/@mip/db/package.json
COPY packages/db/migrate.mjs       ./node_modules/@mip/db/migrate.mjs
COPY packages/db/sql               ./node_modules/@mip/db/sql

# 2 bis) La base IP→pays, OPTIONNELLE de bout en bout.
#
# `|| true` N'EST PAS UNE NÉGLIGENCE, C'EST LE CONTRAT : GeoIP ne doit jamais
# empêcher quoi que ce soit. db-ip.com indisponible, réseau coupé, empreinte qui
# ne correspond pas — l'image se construit quand même, part sans base, et
# l'ingestion se comporte exactement comme avant ce lot (pays estimé d'après le
# fuseau). `--build-arg GEOIP_FETCH=0` pour une construction sans aucune sortie
# réseau ; la base se monte alors sur un volume, via GEOIP_DB_PATH.
#
# CE TÉLÉCHARGEMENT N'EST PAS UN APPEL DE GÉOLOCALISATION : c'est un fichier
# statique public, tiré une fois à la construction. Aucune adresse de visiteur
# n'est envoyée nulle part, ni ici ni à l'exécution.
#
# Téléchargé par `fetch` de Node et non par `wget` : l'image Debian « slim » n'a
# ni wget ni curl, et le `|| true` ci-dessous aurait transformé leur absence en
# une image SANS base, sans une ligne d'erreur. Node, lui, est là par définition.
ARG GEOIP_FETCH=1
ARG GEOIP_VERSION=dbip-country-lite-2026-09
ARG GEOIP_SHA256=a32bb3c384bd3de60ad9024596aa5b395a6dd5beaa27a7223407cc2edc681d0b
RUN if [ "$GEOIP_FETCH" = "1" ]; then \
      cible="./node_modules/@mip/backend/data/${GEOIP_VERSION}.csv.gz"; \
      node -e 'const [url, cible] = process.argv.slice(1); \
        fetch(url, { signal: AbortSignal.timeout(120000) }) \
          .then(async (r) => { if (!r.ok) throw new Error(`HTTP ${r.status}`); \
            require("node:fs").writeFileSync(cible, Buffer.from(await r.arrayBuffer())); }) \
          .catch((e) => { console.error(`geoip: ${e.message}`); process.exit(1); });' \
        "https://download.db-ip.com/free/${GEOIP_VERSION}.csv.gz" "$cible" \
        && echo "${GEOIP_SHA256}  ${cible}" | sha256sum -c - \
        || { echo "geoip: base non déposée, l'ingestion fonctionnera sans"; rm -f "$cible"; }; \
    fi; \
    true

# 3) Les points d'entrée. Minces par construction : ils câblent, ils
#    n'implémentent pas.
COPY services ./services

ENV NODE_ENV=production \
    LOG_LEVEL=info

# Le port est imposé par l'hébergeur (Railway fournit PORT) ; 4318 est le défaut
# local, celui qu'attend la configuration de test.
EXPOSE 4318

# Non-root : l'image node fournit l'utilisateur `node`.
USER node

# Défaut = l'ingestion. Le service `scheduler` remplace cette commande.
CMD ["node", "services/collector/server.mjs"]
