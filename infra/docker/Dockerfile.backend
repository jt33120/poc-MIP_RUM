# Image du backend MIP RUM — ingestion, travaux planifiés, migrations.
#
# UNE image pour TOUS les services backend : ils partagent le même noyau
# (`apps/ingest`) et les mêmes dépendances. Ce qui les distingue est la commande
# de démarrage, choisie par le service qui la lance :
#
#   node services/ingest/server.mjs      receveur OTLP (traces, logs, replay)
#   node services/scheduler/worker.mjs   déclencheur des travaux planifiés
#   node node_modules/ingest/migrate.mjs applique les migrations SQL en attente
#
# Construire deux images pour deux commandes ferait deux fois le même travail et
# ouvrirait la porte à ce qu'elles divergent d'une version.
#
# PAS DE pnpm ICI, À DESSEIN. Le dépôt est un monorepo pnpm, mais faire un
# `pnpm install` à la racine tirerait Next.js, React, Recharts et Playwright —
# des centaines de mégaoctets dont le backend n'a aucun usage. La seule
# dépendance runtime est `pg`. On l'installe depuis le manifeste du noyau, ce
# qui en fige la version (8.21.0), et on recompose l'arborescence à la main.
#
# Contexte de build = RACINE du dépôt (Railway le fait par défaut).
FROM node:22-alpine

WORKDIR /app

# 1) La seule dépendance runtime. Installée d'abord : cette couche ne change
#    qu'à un changement de version de pg, donc elle reste en cache.
COPY apps/ingest/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force

# 2) Le noyau, placé là où Node résout le specifier nu `ingest/...`. C'est ce
#    qui permet aux services d'écrire `import … from "ingest/lib/receiver.mjs"`
#    exactement comme en développement, où pnpm pose le même lien symbolique.
#    `pg` reste résolu en remontant à /app/node_modules.
COPY apps/ingest/package.json   ./node_modules/ingest/package.json
COPY apps/ingest/lib            ./node_modules/ingest/lib
COPY apps/ingest/jobs           ./node_modules/ingest/jobs
COPY apps/ingest/migrate.mjs    ./node_modules/ingest/migrate.mjs
COPY apps/ingest/dispatch-alerts.mjs ./node_modules/ingest/dispatch-alerts.mjs
COPY apps/ingest/purge.mjs      ./node_modules/ingest/purge.mjs
# Les modules partagés (parser OTLP, CORS, limites, scrub, retry, journal). Le
# chemin `supabase/functions/_shared` est un vestige des edge functions : le
# fournisseur a disparu en août 2026, le code non. Il est exposé sous
# `ingest/shared/*` par la carte `exports` du manifeste — c'est ce nom-là que le
# code utilise, jamais le chemin physique.
COPY apps/ingest/supabase/functions/_shared ./node_modules/ingest/supabase/functions/_shared
# Le SQL : nécessaire au runner de migrations, qui lit le dossier au démarrage.
COPY apps/ingest/sql            ./node_modules/ingest/sql

# 3) Les points d'entrée. Minces par construction : ils câblent, ils
#    n'implémentent pas.
COPY services ./services

ENV NODE_ENV=production \
    LOG_LEVEL=info

# Le port est imposé par l'hébergeur (Railway fournit PORT) ; 4318 est le défaut
# local, celui qu'attend la configuration de test.
EXPOSE 4318

# Non-root : l'image node fournit l'utilisateur `node`.
USER node

# Défaut = l'ingestion. Le service `scheduler` remplace cette commande.
CMD ["node", "services/ingest/server.mjs"]
