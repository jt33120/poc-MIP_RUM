# Backend d'ingestion OTLP MIP RUM, conteneurisé (self-host souverain).
# C'est le MÊME code que l'edge function Deno de prod : dev-server.mjs est un vrai
# serveur HTTP Node (OTLP /v1/traces -> Postgres) avec health/ready, rate-limit,
# vérif clé d'API et arrêt propre. Ici on l'empaquette pour tourner en conteneur
# (au lieu de Supabase Edge Functions), afin d'avoir des logs de conteneur.
#
# Contexte de build = racine du repo (cf. docker-compose.yml) pour pouvoir copier
# apps/ingest et ses modules partagés _shared/.
FROM node:22-alpine

WORKDIR /app

# Seule dépendance runtime : pg (le reste est du code local .mjs). On installe
# à partir du package.json d'ingest pour figer la version (pg 8.21.0).
COPY apps/ingest/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force

# Le serveur + ses modules partagés. dev-server.mjs importe en relatif
# ./supabase/functions/_shared/*.mjs — on préserve donc cette arborescence.
# purge.mjs (rétention TTL) partage pg + _shared : embarqué pour la commande
# `docker compose exec ingest node purge.mjs` (pg_cron absent sur postgres:15).
COPY apps/ingest/dev-server.mjs ./dev-server.mjs
COPY apps/ingest/purge.mjs ./purge.mjs
COPY apps/ingest/supabase/functions/_shared ./supabase/functions/_shared

ENV NODE_ENV=production \
    INGEST_PORT=4318 \
    LOG_LEVEL=info

EXPOSE 4318

# Non-root (l'image node fournit l'utilisateur `node`).
USER node

# liveness /health, readiness /ready (sonde la base) — cf. compose healthcheck.
CMD ["node", "dev-server.mjs"]
