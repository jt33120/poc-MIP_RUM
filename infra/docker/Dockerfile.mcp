# Image du serveur MCP MIP RUM — l'API v1 de lecture, exposée à un agent IA.
#
# POURQUOI UNE IMAGE À PART, alors que Dockerfile.backend en fait une seule pour
# l'ingestion, le scheduler et les migrations. Ce n'est pas une entorse à cette
# règle, c'en est l'application : là-bas, une seule image parce que MÊME noyau et
# MÊMES dépendances. Ici, ni l'un ni l'autre — et surtout :
#
#   CE SERVICE NE DOIT PAS POUVOIR ATTEINDRE LA BASE.
#
# Il est joignable depuis l'internet et pilotable par un modèle de langage, donc
# par le texte que ce modèle a lu. La seule protection qui tienne contre une
# injection de prompt réussie, c'est qu'il n'y ait rien à atteindre : pas de
# `pg`, pas de DATABASE_URL, aucun accès réseau à Postgres. Tout passe par
# l'API v1, qui applique déjà le cloisonnement par jeton.
#
# Empaqueter le serveur MCP dans l'image du backend annulerait cette garantie
# pour économiser une couche de cache.
#
# PAS DE pnpm ICI, comme pour le backend : `npm install` depuis le manifeste du
# noyau fige les versions du SDK MCP et de zod, et l'arborescence est recomposée
# à la main. Contexte de build = RACINE du dépôt.
#
# Node 24 sur Debian, comme `Dockerfile.backend` et pour les mêmes raisons (un
# seul runtime, celui de `.nvmrc` ; glibc comme la CI) — voir son en-tête.
# Épinglée par étiquette seulement ; le digest arrive avec PR-C.
FROM node:24-bookworm-slim

WORKDIR /app

# 1) Les dépendances runtime : le SDK MCP et zod, rien d'autre. Couche mise en
#    cache tant que ces deux versions ne bougent pas.
COPY packages/mcp-tools/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force

# 2) Le noyau MCP, placé là où Node résout le specifier nu `@mip/mcp-tools/...` —
#    exactement comme en développement, où pnpm pose le même lien.
COPY packages/mcp-tools/package.json ./node_modules/@mip/mcp-tools/package.json
COPY packages/mcp-tools/serveur.mjs  ./node_modules/@mip/mcp-tools/serveur.mjs
COPY packages/mcp-tools/lib          ./node_modules/@mip/mcp-tools/lib

# 3) Les points d'entrée. Minces par construction.
COPY services/mcp ./services/mcp

ENV NODE_ENV=production

# Le port est imposé par l'hébergeur (Railway fournit PORT) ; 8080 est le défaut.
EXPOSE 8080

# Non-root : l'image node fournit l'utilisateur `node`.
USER node

# Le transport distant. `services/mcp/stdio.mjs` existe pour l'usage LOCAL
# (Claude Desktop, un IDE) et n'a pas vocation à tourner dans un conteneur.
CMD ["node", "services/mcp/http.mjs"]
