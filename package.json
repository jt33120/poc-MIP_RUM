{
  "name": "mip-rum",
  "version": "0.1.0",
  "private": true,
  "description": "POC MIP RUM — Real User Monitoring OpenTelemetry-native (hybride : OTLP/HTTP JSON + Postgres)",
  "scripts": {
    "build": "pnpm -r build",
    "build:sdk": "pnpm --filter \"@mip/rum-sdk...\" --filter \"@mip/rum-mobile...\" --filter \"@mip/agent-node...\" build",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:sql": "vitest run tests/integration --no-file-parallelism",
    "test:contract": "vitest run tests/contract --no-file-parallelism",
    "test:isolation": "node scripts/verify-tenant-isolation.mjs",
    "test:alerting": "node scripts/verify-alerting.mjs",
    "test:svi": "node scripts/verify-svi-modele.mjs"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@playwright/test": "1.60.0",
    "pg": "8.21.0",
    "railway": "^3.11.0",
    "vitest": "4.1.8"
  }
}
