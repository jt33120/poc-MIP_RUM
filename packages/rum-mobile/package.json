{
  "name": "@mip/rum-mobile",
  "version": "0.4.0",
  "private": true,
  "description": "SDK MIP RUM pour React Native — crashes, écrans, réseau (traceparent), contexte/identité P2 et événements en OTLP. Réutilise la pipeline web (mêmes tables, device_type mobile). Sans dépendance runtime.",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@mip/rum-core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "5.9.3"
  }
}
