{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Ni DOM ni types Node : le contrat ne touche ni au réseau, ni au disque, ni
    // au navigateur. Le compilateur le vérifie, pas une relecture.
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
