node_modules/
dist/
.next/

# Artefacts générés (jamais versionnés) : cache incrémental tsc + couverture
*.tsbuildinfo
coverage/
*.log
.DS_Store
test-results/
playwright-report/
blob-report/
.turbo/
*.tgz
.vercel/
scratchpad/

# Réglages d'éditeur : propres à chaque poste, rien à en tirer pour le dépôt.
.vscode/
.idea/

# SECRETS — toute variante d'environnement, sauf les exemples. Le dépôt est
# public, et Next.js lit de lui-même `.env.development.local`, `.env.test`… : ne
# lister que `.env`, `.env.local` et `.env.production` en laissait passer. Calqué
# sur `.dockerignore`, qui l'était déjà.
.env
.env.*
!.env.example
!**/.env.example
.envrc
.secrets*
*.pem
*.key
*.p12
*.pfx
id_rsa*

# v0.4 demo backend
tests/e2e/site-cobaye/.venv/
__pycache__/

# Ext-D : clé privée de signature de l'extension — NE JAMAIS committer (l'ID
# d'extension stable dérive de la clé PUBLIQUE, déjà dans manifest.json "key" ;
# la clé privée sert uniquement à empaqueter un .crx signé, conservée hors repo)
apps/extension/*.pem
apps/extension/*-key*.der
apps/extension/*-key*.b64

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
# …et son réglage de recherche ripgrep, propre à l'outil (outillage local).
.ignore

# OUTILLAGE IA LOCAL — présent sur le poste, absent du dépôt.
#
# Ces répertoires ne décrivent pas le produit : ce sont les réglages et les
# artefacts des agents qui l'ont écrit (863 fichiers, un tiers du dépôt). Un
# lecteur qui clone MIP RUM n'a rien à en faire, et leur présence brouillait la
# lecture de l'arbre. Ils restent sur le poste ; seul le suivi git est retiré.
#
# EXCLUSION PAR SOUS-CHEMIN, JAMAIS `.claude/` EN BLOC : `.claude/worktrees/`
# héberge des copies de travail complètes du dépôt. Un `git clean -x` les
# effacerait, y compris du travail non fusionné. Ne pas lancer `git clean -x`
# tant que ces répertoires vivent.
.claude/helpers/
.claude/settings.json
.claude/settings.local.json
.claude/skills/
.claude/worktrees/
# État d'exécution de Claude Code : ces lignes vivaient dans `.git/info/exclude`,
# donc sur un seul poste ; un autre clone les aurait vues comme fichiers à suivre.
**/.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.json
**/.claude/routines/.state/
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json
.agents/
.codex/
_bmad/
_bmad-output/
.mcp.json

# LA DOCUMENTATION VIT SUR LE POSTE (06/10/2026) : architecture, ADR, exploitation,
# intégration, documents commerciaux et documents de travail. Le dépôt public ne
# porte que ce qui sert à construire, tester, déployer et faire tourner le produit.
/docs/
/labs/
/local/
