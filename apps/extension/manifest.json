{
  "manifest_version": 3,
  "name": "MIP RUM — capteur navigateur",
  "version": "0.4.1",
  "description": "Capteur RUM MIP. Observe UNIQUEMENT les domaines enregistrés côté MIP (aucune collecte hors périmètre, jamais sur <all_urls>). Mesure Core Web Vitals et erreurs des vrais utilisateurs.",
  "key": "",
  "permissions": [
    "scripting",
    "webNavigation",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "vendor/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MIP RUM",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
