# VARIABLES D'ENVIRONNEMENT DE LA CONSOLE — modèle, sans aucune valeur.
#
# En production, elles se posent sur Vercel (projet de la console), jamais dans un
# fichier du dépôt. En local, copier ce modèle en `apps/console/.env.local` (ignoré
# par git), que Next lit au démarrage, et n'y mettre que des valeurs LOCALES : jamais
# l'URL de la base de production (AGENTS.md, « Sécurité et exploitation »).
#
# Chaque ligne est commentée : une variable VIDE n'est pas une variable ABSENTE.
# Plusieurs lectures ont un défaut en `??` (limites de débit, `PGPOOL_MAX`…) et
# `Number("")` vaut 0 : décommenter une ligne sans la remplir désactiverait ce défaut.
#
# Ce fichier couvre ce que lit le code de `apps/console` ; les modules de
# `packages/` qu'elle importe lisent aussi les leurs. `tests/unit/console-env-example.test.ts`
# échoue si une variable lue par la console manque ici.

# ── Base et sessions ─────────────────────────────────────────────────────────
# Chaîne de connexion Postgres de la console ; SECRET ; Vercel (en local, défaut : localhost:5433/mip_rum).
# DATABASE_URL=
# Taille du pool Postgres par instance (défaut 10) ; non secret ; Vercel.
# PGPOOL_MAX=
# Clé de signature des cookies de session, exigée en production ; SECRET ; Vercel.
# AUTH_SECRET=
# Clé du hachage des identités (user_id, account_id) reçues ou effacées ; SECRET ; Vercel.
# IDENTITY_HASH_SECRET=
# « 1 » : le build refuse un environnement qui porte encore une base ou un secret d'identité ; non secret ; Vercel.
# MIP_CONSOLE_SANS_BASE=
# Applications (séparées par des virgules) ouvertes par la session de démonstration ; non secret ; Vercel.
# DEMO_USER_APPS=
# Adresse qui nomme la session de démonstration dans le journal (facultative) ; non secret ; Vercel.
# DEMO_USER_EMAIL=

# ── console-api (piste C) ────────────────────────────────────────────────────
# URL du service console-api ; non secret ; Vercel (va avec les deux suivantes).
# CONSOLE_API_URL=
# Secret client envoyé à console-api (32 caractères au moins) ; SECRET ; Vercel.
# CONSOLE_API_CLIENT_SECRET=
# Jeu de clés PUBLIQUES (JWKS) qui vérifie les sessions et la poignée de main de console-api ; non secret ; Vercel.
# SESSION_PUBLIC_JWKS=
# « 1 » : mode strict, toute session de console-api est servie par le service, sans repli sur la base ; non secret ; Vercel.
# CONSOLE_API_STRICT=
# Pourcentage par défaut des écrans servis par console-api, quand la base ne dit rien ; non secret ; Vercel.
# CONSOLE_API_ECRANS_PCT=
# Pourcentage par défaut des commandes servies par console-api, quand la base ne dit rien ; non secret ; Vercel.
# CONSOLE_API_COMMANDES_PCT=

# ── Relais vers les services Railway ─────────────────────────────────────────
# URL du collector vers lequel la collecte est relayée ; non secret ; Vercel.
# CONSOLE_INGEST_RELAY_URL=
# Secret partagé du bord de confiance (`x-mip-edge-auth`) exigé par le collector ; SECRET ; Vercel.
# EDGE_PROXY_SECRET=
# « 1 » : relais pur de la collecte, sans tirage ni chemin local ; non secret ; Vercel.
# CONSOLE_INGEST_RELAY_STRICT=
# Pourcentage de collecte relayée quand la base ne répond pas (0 en production) ; non secret ; Vercel.
# INGEST_RELAY_PCT=
# URL du service `api` vers lequel l'API v1 est relayée ; non secret ; Vercel.
# CONSOLE_API_RELAY_URL=
# Pourcentage par défaut de l'API v1 relayée, quand la base ne dit rien ; non secret ; Vercel.
# API_RELAY_PCT=
# URL du notifier, qui reçoit les demandes de ticket ; non secret ; Vercel.
# CONSOLE_TICKET_HOOK_URL=

# ── Collecte (routes d'ingestion de la console) ──────────────────────────────
# « true » : la collecte refuse une application sans clé d'ingestion ; non secret ; Vercel.
# REQUIRE_API_KEY=
# Envois acceptés par minute et par application (défaut 600) ; non secret ; Vercel.
# RATE_LIMIT_PER_MIN=
# Rétention de la purge, en jours (défaut 30) : au-delà, l'Explorer dit la fenêtre non couverte ; non secret ; Vercel.
# RETENTION_DAYS=
# « 1 » : les agrégats exactement additifs se lisent dans les rollups horaires ; non secret ; Vercel.
# RUM_USE_ROLLUPS=

# ── Capteur de la console sur elle-même ─────────────────────────────────────
# URL complète du canal traces donnée aux clients et au capteur (défaut : l'hôte de la requête) ; non secret ; Vercel.
# NEXT_PUBLIC_RUM_ENDPOINT=
# Origine du collector pour la collecte directe du capteur de la console ; non secret ; Vercel.
# NEXT_PUBLIC_DOGFOOD_COLLECTOR_URL=
# Clé d'ingestion du capteur de la console (`mip_` + 32 hex), publique par nature ; non secret ; Vercel.
# NEXT_PUBLIC_DOGFOOD_API_KEY=
# Taux de rejeu du capteur de la console, de 0 à 1 (défaut 1) ; non secret ; Vercel.
# NEXT_PUBLIC_RUM_REPLAY=
# Point d'entrée des journaux de la console (défaut : son propre canal logs) ; non secret ; Vercel.
# CONSOLE_LOGS_ENDPOINT=
# Application sous laquelle la console range ses journaux (défaut mip-rum-console) ; non secret ; Vercel.
# CONSOLE_LOG_APP_ID=

# ── API v1 et points d'accès ─────────────────────────────────────────────────
# Jetons Bearer de l'API v1, `jeton` ou `jeton@app1;app2`, séparés par des virgules ; SECRET ; Vercel.
# CONSOLE_API_TOKENS=
# Origines autorisées par CORS sur l'API v1, séparées par des virgules ; non secret ; Vercel.
# CONSOLE_API_ALLOWED_ORIGINS=
# Requêtes par minute et par principal sur l'API v1 (défaut 120, 0 = sans limite) ; non secret ; Vercel.
# CONSOLE_API_RATE_LIMIT=
# Requêtes par minute et par jeton sur `/api/rum/summary` (défaut 60) ; non secret ; Vercel.
# RUM_READ_RATE_LIMIT=
# Jeton de `/api/metrics` ; absent, la route répond 404 ; SECRET ; Vercel.
# METRICS_TOKEN=

# ── Extension navigateur ─────────────────────────────────────────────────────
# Lien de l'extension sur le Chrome Web Store, affiché à l'installation ; non secret ; Vercel.
# CHROME_STORE_URL=
# URL de mise à jour de l'extension en déploiement géré, affichée à l'installation ; non secret ; Vercel.
# EXTENSION_UPDATE_URL=
# Battements acceptés par heure et par installation (défaut du code) ; non secret ; Vercel.
# EXTENSION_HEARTBEAT_RATE_LIMIT=
# Résolutions de périmètre acceptées par minute et par domaine (défaut du code) ; non secret ; Vercel.
# EXTENSION_RESOLVE_RATE_LIMIT=

# ── SSO OIDC (absent : pas de SSO) ──────────────────────────────────────────
# Émetteur OIDC ; non secret ; Vercel.
# OIDC_ISSUER=
# Identifiant client OIDC ; non secret ; Vercel.
# OIDC_CLIENT_ID=
# Secret client OIDC ; SECRET ; Vercel.
# OIDC_CLIENT_SECRET=
# URL de retour après connexion ; non secret ; Vercel.
# OIDC_REDIRECT_URI=
# Portées demandées (défaut « openid email profile ») ; non secret ; Vercel.
# OIDC_SCOPES=
# Revendication qui porte le rôle ; non secret ; Vercel.
# OIDC_ROLE_CLAIM=
# Valeurs de cette revendication qui font un administrateur, séparées par des virgules ; non secret ; Vercel.
# OIDC_ADMIN_VALUES=
# Revendication qui porte les applications autorisées ; non secret ; Vercel.
# OIDC_APPS_CLAIM=

# ── Intégrations ─────────────────────────────────────────────────────────────
# « 1 » : ouvre l'écran des intégrations de tickets ; non secret ; Vercel.
# TICKET_INTEGRATIONS=
# Origine de la console inscrite dans les liens des tickets (défaut : l'hôte de la requête) ; non secret ; Vercel.
# MIP_CONSOLE_URL=
# URL de l'API de synthèse IA de xSOM ; non secret ; Vercel.
# XSOM_AI_URL=
# Jeton de lecture de l'API de synthèse IA de xSOM ; SECRET ; Vercel.
# XSOM_AI_TOKEN=
# Délai d'attente de xSOM en millisecondes (défaut 4000) ; non secret ; Vercel.
# XSOM_AI_TIMEOUT_MS=
# Lien vers la console publique de xSOM (défaut : son domaine Railway) ; non secret ; Vercel.
# XSOM_CONSOLE_URL=

# ── Posées par la plateforme : ne pas les poser à la main ────────────────────
# Mode d'exécution ; non secret ; posée par Next.
# NODE_ENV=
# Environnement Vercel (`production`, `preview`…) : ferme la vitrine des composants en production ; non secret ; posée par Vercel.
# VERCEL_ENV=
# Domaine du déploiement ; non secret ; posée par Vercel.
# VERCEL_URL=
# Domaine de production du projet ; non secret ; posée par Vercel.
# VERCEL_PROJECT_PRODUCTION_URL=
# SHA du commit déployé, version (`release`) du capteur de la console ; non secret ; posée par Vercel.
# VERCEL_GIT_COMMIT_SHA=
